# ThreatLens Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# --- Application Settings ---
APP_NAME=ThreatLens
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=threatlens_secure_pwd
POSTGRES_DB=threatlens_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full SQLAlchemy Database URL (PostgreSQL)
# For Docker Compose: postgresql+psycopg://threatlens:threatlens_secure_pwd@postgres:5432/threatlens_db
# For Local Host Postgres: postgresql+psycopg://threatlens:threatlens_secure_pwd@localhost:5432/threatlens_db
DATABASE_URL=postgresql+psycopg://threatlens:threatlens_secure_pwd@postgres:5432/threatlens_db

# --- Security & Authentication ---
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Default Seed Credentials (Used on Initial DB Bootstrap) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@threatlens.local
INITIAL_ADMIN_PASSWORD=ThreatLens!Admin2026
INITIAL_ANALYST_USERNAME=analyst
INITIAL_ANALYST_EMAIL=analyst@threatlens.local
INITIAL_ANALYST_PASSWORD=ThreatLens!Analyst2026

# --- CORS & Rate Limiting ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_MINUTE=600
RATE_LIMIT_INTEL_PER_MINUTE=60
RATE_LIMIT_EXPORT_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=300

# --- Threat Intelligence External Providers (Optional) ---
# Leave blank to use built-in local PostgreSQL IOC database & SIEM telemetry correlation only.
# ThreatLens never fabricates external reputation scores when API keys are omitted.
#
# 1. AbuseIPDB API v2 Key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=
# 2. VirusTotal API v3 Key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=
# 3. AlienVault OTX DirectConnect API Key (https://otx.alienvault.com/api)
OTX_API_KEY=

# --- Frontend Build / Runtime Variables ---
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

