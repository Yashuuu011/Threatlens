# ==============================================================================
# ThreatLens .gitignore - Python (FastAPI) + React (TypeScript/Vite) + Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Testing & Code Quality
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# ------------------------------------------------------------------------------
# Frontend / Node.js / Vite
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/.vite/
.vite/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Database & Local State Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
postgres_data/
*.rdb

# ------------------------------------------------------------------------------
# Log Files
# ------------------------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
